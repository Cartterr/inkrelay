{
  "name": "@inkrelay/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/serve.ts",
    "start": "node dist/serve.js",
    "schedule": "node dist/schedule.js",
    "lint": "biome lint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1107.0",
    "@inkrelay/core": "workspace:*",
    "@inkrelay/db": "workspace:*",
    "@inkrelay/rendering": "workspace:*",
    "pg-boss": "^12.11.0",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "sharp": "^0.35.0",
    "tsx": "^4.20.0"
  }
}
